# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
dev.log
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!frontend/.env.example

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# Split application outputs
/frontend/node_modules/
**/node_modules/
/frontend/.next/
/frontend/.vinext/
/frontend/dist/
/frontend/.wrangler/
/frontend/.vite/
/.vite/
*.tsbuildinfo
