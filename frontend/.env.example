# Comma-separated authenticated email addresses allowed for each portal.
JOURNAWAY_ADMIN_EMAILS=admin@example.com
JOURNAWAY_DRIVER_EMAILS=driver@example.com
JOURNAWAY_HOTEL_PARTNER_EMAILS=hotel.partner@example.com

# Local development only. This is ignored in production because local auth is
# hard-disabled unless NODE_ENV is development. It is enabled by default in
# local development; set this to false to disable it. The local email must also
# be present in the allowlist for the dashboard you want to test.
JOURNAWAY_ENABLE_LOCAL_AUTH=true
JOURNAWAY_LOCAL_AUTH_EMAIL=admin@example.com
JOURNAWAY_LOCAL_AUTH_NAME=Local Admin
# Optional: stable test identity. Defaults to local:<email> when omitted.
JOURNAWAY_LOCAL_AUTH_USER_ID=local-admin

# PostgreSQL is required for API routes and portal data in the self-hosted app.
DATABASE_URL=postgresql://journaway:replace-with-a-long-unique-password@localhost:5432/journaway

GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=JournAway <bookings@your-domain.com>
