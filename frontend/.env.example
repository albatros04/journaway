# Private admin portal credentials for local development.
JOURNAWAY_ADMIN_USERNAME=admin
JOURNAWAY_ADMIN_PASSWORD=replace-with-a-long-unique-password
JOURNAWAY_ADMIN_SESSION_SECRET=replace-with-a-32-plus-character-random-secret

# Local development only. This is hard-disabled in production. The local email
# is used only while testing driver or hotel portal access.
JOURNAWAY_ENABLE_LOCAL_AUTH=true
JOURNAWAY_LOCAL_AUTH_EMAIL=driver@example.com
JOURNAWAY_LOCAL_AUTH_NAME=Local User
JOURNAWAY_LOCAL_AUTH_USER_ID=local-user

DATABASE_URL=postgresql://journaway:replace-with-a-long-unique-password@localhost:5432/journaway
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=JournAway <bookings@your-domain.com>
