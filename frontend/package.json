    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .netlify --ignore-pattern .output",
    "build:vinext": "vinext build",
    "start:vinext": "vinext start"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/nodemailer": "^6.4.24",
