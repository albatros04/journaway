# Public hostname for this deployment, for example staging.journaway.in.
JOURNAWAY_DOMAIN=staging.journaway.in

# PostgreSQL credentials. Use a unique long password and use the same value in
# POSTGRES_PASSWORD and DATABASE_URL (URL-encode special characters).
POSTGRES_DB=journaway
POSTGRES_USER=journaway
POSTGRES_PASSWORD=replace-with-a-long-unique-password
DATABASE_URL=postgresql://journaway:replace-with-a-long-unique-password@db:5432/journaway

# Customer/portal authentication and transactional email.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-your-resend-api-key
EMAIL_FROM=JournAway <bookings@journaway.in>

# Comma-separated Google-authenticated identities permitted in each portal.
JOURNAWAY_ADMIN_EMAILS=admin@journaway.in
JOURNAWAY_DRIVER_EMAILS=driver@journaway.in
JOURNAWAY_HOTEL_PARTNER_EMAILS=hotel.partner@journaway.in
